# ================================================
# FEMHEALTH PWA - .gitignore
# ================================================

# ================================================
# SENSITIVE FILES - NEVER COMMIT
# ================================================

# Environment variables (API keys, secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# API Keys and secrets
*.secret
*.secrets
secrets.json
secrets.properties
api-keys.json
credentials.json

# Firebase configuration (contains project secrets)
google-services.json
firebase-config.json
firebase-adminsdk*.json
serviceAccountKey.json

# Claude/Anthropic API keys
anthropic.json
claude-config.json

# Sarvam AI keys
sarvam-config.json

# Google Cloud credentials
gcloud-credentials.json
*.p12

# Local configuration (Android legacy - contains API keys)
local.properties

# ================================================
# PWA / NODE.JS
# ================================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.nuxt/
.output/
.vercel/
.netlify/

# Cache
.cache/
.parcel-cache/
.turbo/

# Testing
coverage/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo

# PWA generated
sw.js
workbox-*.js
precache-manifest.*.js

# ================================================
# ANDROID (Legacy - kept for reference)
# ================================================

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
release/

# Gradle files
.gradle/
**/build/

# Proguard folder
proguard/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild/
.cxx/

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# ================================================
# IDE & EDITORS
# ================================================

# IntelliJ / Android Studio
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/*.iml

# VS Code
.vscode/
*.code-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.#*

# ================================================
# OS FILES
# ================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ================================================
# TESTING & COVERAGE
# ================================================

coverage/
*.exec
*.lcov
.jest/
jest-results/
playwright-report/
test-results/

# ================================================
# MISC
# ================================================

# Firebase
firebase-debug.log
.firebase/
firestore-debug.log
ui-debug.log

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Backup files
*.bak
*.backup

# Version control (nested)
vcs.xml

# Debug
*.debug

# Database files (local dev)
*.sqlite
*.sqlite3
*.db

# Certificates (except public certs)
*.pem
*.key
!public.pem
!public.key

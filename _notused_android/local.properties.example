# Local properties template - Copy this to local.properties and fill in values
# DO NOT COMMIT local.properties - it contains sensitive API keys

# Android SDK location (set automatically by Android Studio)
# sdk.dir=/path/to/android/sdk

# Anthropic Claude API Key (Primary AI - for symptom triage, screening interpretation, health education)
# Get your key at: https://console.anthropic.com/settings/keys
# Model used: claude-opus-4-6
CLAUDE_API_KEY=your_claude_api_key_here

# Google Gemini API Key (Backup AI - failover when Claude is unavailable)
# Get your key at: https://aistudio.google.com/apikey
# Model used: gemini-3-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (for speech-to-text, text-to-speech in Indian languages)
# Get your key at: https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Cloud Translation API Key (for non-Indian languages - Africa, other South Asia)
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable "Cloud Translation API" in Google Cloud Console
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
